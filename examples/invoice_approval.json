{
  "name": "Accounts Payable Invoice Approval",
  "description": "From a vendor invoice arriving by email to payment released: extraction, matching, approval tiers, exceptions, and vendor communication.",
  "steps": [
    {
      "id": "forward_to_ap_inbox",
      "name": "Forward vendor invoices to AP inbox",
      "actor": "Email rule",
      "system": "Email",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["operational"],
      "volume": "high",
      "exception_rate": "low",
      "already_automated": true
    },
    {
      "id": "extract_invoice_fields",
      "name": "Extract fields from invoice PDF",
      "actor": "AP clerk",
      "system": "AP inbox",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "medium",
      "depends_on": ["forward_to_ap_inbox"],
      "notes": "Vendor, invoice number, PO number, amounts, due date. Every layout is different. Errors are caught by the 3-way match."
    },
    {
      "id": "three_way_match",
      "name": "Match invoice to PO and receipt",
      "actor": "AP clerk",
      "system": "ERP",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "medium",
      "depends_on": ["extract_invoice_fields"],
      "notes": "Rule: quantities and amounts match within 2% tolerance."
    },
    {
      "id": "check_duplicate",
      "name": "Check for duplicate invoice",
      "actor": "AP clerk",
      "system": "ERP",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "low",
      "depends_on": ["extract_invoice_fields"],
      "notes": "Rule: same vendor + invoice number, or same vendor + amount + date."
    },
    {
      "id": "suggest_gl_coding",
      "name": "Code invoice lines to GL accounts",
      "actor": "AP clerk",
      "system": "ERP",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "medium",
      "depends_on": ["extract_invoice_fields"],
      "notes": "Line descriptions are free text. Miscoding affects financial reporting."
    },
    {
      "id": "resolve_match_exception",
      "name": "Resolve mismatch with vendor",
      "actor": "AP clerk",
      "system": "Email",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["financial", "relationship"],
      "volume": "medium",
      "exception_rate": "high",
      "depends_on": ["three_way_match"]
    },
    {
      "id": "approve_within_tolerance",
      "name": "Approve matched invoice under limit",
      "actor": "AP clerk",
      "system": "ERP",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "low",
      "depends_on": ["three_way_match", "check_duplicate"],
      "notes": "Rule: matched, not a duplicate, and under the approval limit."
    },
    {
      "id": "approve_high_value",
      "name": "Approve high-value or non-PO invoice",
      "actor": "Finance manager",
      "system": "ERP",
      "input_type": "structured",
      "rule_clarity": "partial",
      "reversibility": "costly",
      "consequence": "high",
      "domains": ["financial"],
      "volume": "low",
      "exception_rate": "high",
      "depends_on": ["three_way_match", "check_duplicate"]
    },
    {
      "id": "handle_bank_detail_change",
      "name": "Handle vendor bank detail change",
      "actor": "Finance manager",
      "system": "Email / ERP vendor master",
      "input_type": "unstructured",
      "rule_clarity": "none",
      "reversibility": "irreversible",
      "consequence": "high",
      "domains": ["financial", "compliance"],
      "volume": "low",
      "exception_rate": "high",
      "notes": "The classic invoice-fraud vector. Requires call-back verification on a known number."
    },
    {
      "id": "release_payment",
      "name": "Release payment to vendor",
      "actor": "AP clerk",
      "system": "Banking",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "irreversible",
      "consequence": "high",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "low",
      "depends_on": ["approve_within_tolerance", "approve_high_value", "handle_bank_detail_change"],
      "notes": "Rule: approved AND not a duplicate AND vendor bank details verified. Money sent is hard to get back."
    },
    {
      "id": "send_remittance",
      "name": "Send remittance advice",
      "actor": "ERP",
      "system": "ERP",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["relationship"],
      "volume": "high",
      "exception_rate": "low",
      "already_automated": true,
      "depends_on": ["release_payment"]
    },
    {
      "id": "answer_payment_status",
      "name": "Answer vendor payment status emails",
      "actor": "AP clerk",
      "system": "Email",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["relationship"],
      "volume": "high",
      "exception_rate": "low",
      "notes": "\"Where's my payment?\" Answer comes from ERP status; low risk if slightly off."
    }
  ]
}
