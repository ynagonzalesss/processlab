{
  "name": "Vacation Rental Guest Onboarding",
  "description": "From confirmed booking to guest arrival, including agreement, city-required ID verification, check-in release, and in-stay issues. Based on a real short-term rental operation.",
  "steps": [
    {
      "id": "record_booking",
      "name": "Record booking in PMS",
      "actor": "Admin",
      "system": "PMS",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["operational"],
      "volume": "high",
      "exception_rate": "low",
      "notes": "Channel bookings sync automatically; direct bookings are entered by hand."
    },
    {
      "id": "send_agreement",
      "name": "Send renter agreement",
      "actor": "PMS trigger",
      "system": "PMS",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["legal"],
      "volume": "high",
      "exception_rate": "low",
      "already_automated": true,
      "depends_on": ["record_booking"]
    },
    {
      "id": "agreement_reminders",
      "name": "Remind guest to sign agreement",
      "actor": "PMS trigger",
      "system": "PMS",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["relationship"],
      "volume": "medium",
      "exception_rate": "low",
      "already_automated": true,
      "depends_on": ["send_agreement"]
    },
    {
      "id": "request_id_verification",
      "name": "Request guest ID verification",
      "actor": "PMS trigger",
      "system": "ID verification service",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["compliance"],
      "volume": "high",
      "exception_rate": "low",
      "already_automated": true,
      "depends_on": ["record_booking"],
      "notes": "City requirement, disclosed in the listing."
    },
    {
      "id": "review_failed_verification",
      "name": "Follow up on failed ID verification",
      "actor": "Admin",
      "system": "ID verification service",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["compliance", "relationship"],
      "volume": "low",
      "exception_rate": "high",
      "depends_on": ["request_id_verification"],
      "notes": "Failure reasons vary (blurry photo, name mismatch, guest confusion). Guest replies are free text."
    },
    {
      "id": "release_checkin_gate",
      "name": "Approve release of check-in details",
      "actor": "Admin",
      "system": "PMS",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "costly",
      "consequence": "high",
      "domains": ["compliance", "safety"],
      "volume": "high",
      "exception_rate": "low",
      "depends_on": ["agreement_reminders", "request_id_verification"],
      "notes": "Rule: agreement signed AND ID verified. No exceptions. Door codes can be changed, but a wrongly released code is a real exposure."
    },
    {
      "id": "send_checkin_info",
      "name": "Send check-in info 1 day before",
      "actor": "PMS trigger",
      "system": "PMS",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["operational"],
      "volume": "high",
      "exception_rate": "low",
      "already_automated": true,
      "depends_on": ["release_checkin_gate"]
    },
    {
      "id": "triage_guest_message",
      "name": "Triage inbound guest message",
      "actor": "Admin",
      "system": "PMS inbox",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["operational"],
      "volume": "high",
      "exception_rate": "medium",
      "depends_on": ["record_booking"],
      "notes": "Classify type (maintenance, payment, access, question) and urgency. A misroute is caught downstream and easy to correct."
    },
    {
      "id": "dispatch_maintenance",
      "name": "Notify maintenance vendor",
      "actor": "Admin",
      "system": "Vendor scheduling tool",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["operational"],
      "volume": "medium",
      "exception_rate": "low",
      "depends_on": ["triage_guest_message"],
      "notes": "Rule: category = maintenance AND urgency >= high -> notify vendor immediately."
    },
    {
      "id": "reply_to_guest",
      "name": "Reply to guest about their issue",
      "actor": "Admin",
      "system": "PMS inbox",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["relationship"],
      "volume": "high",
      "exception_rate": "medium",
      "depends_on": ["triage_guest_message"],
      "notes": "Tone matters: friendly but firm, one topic per message."
    },
    {
      "id": "apply_booking_adjustment",
      "name": "Apply discount or booking adjustment",
      "actor": "Admin",
      "system": "PMS",
      "input_type": "structured",
      "rule_clarity": "partial",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["financial"],
      "volume": "low",
      "exception_rate": "medium",
      "depends_on": ["record_booking"]
    },
    {
      "id": "handle_refund_dispute",
      "name": "Handle refund or payment dispute",
      "actor": "Admin + owner",
      "system": "PMS / payment processor",
      "input_type": "unstructured",
      "rule_clarity": "none",
      "reversibility": "irreversible",
      "consequence": "high",
      "domains": ["financial", "relationship"],
      "volume": "low",
      "exception_rate": "high",
      "depends_on": ["record_booking"]
    }
  ]
}
