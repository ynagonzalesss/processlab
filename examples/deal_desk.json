{
  "name": "Sales Deal Desk Approval",
  "description": "From a sales rep's non-standard deal request to an order released for billing: discount approval, non-standard terms, quoting, and customer communication.",
  "steps": [
    {
      "id": "capture_deal_request",
      "name": "Capture deal details from rep email",
      "actor": "Deal desk analyst",
      "system": "Email",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["operational"],
      "volume": "high",
      "exception_rate": "medium",
      "notes": "Extract customer, product, quantity, term, discount, and start date. Missing or wrong fields are caught by validation in the next step."
    },
    {
      "id": "sync_opportunity",
      "name": "Sync opportunity to CRM",
      "actor": "CRM integration",
      "system": "CRM",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["operational"],
      "volume": "high",
      "exception_rate": "low",
      "already_automated": true
    },
    {
      "id": "validate_deal_fields",
      "name": "Validate required deal fields",
      "actor": "Deal desk analyst",
      "system": "CRM",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "low",
      "domains": ["operational"],
      "volume": "high",
      "exception_rate": "medium",
      "depends_on": ["capture_deal_request", "sync_opportunity"],
      "notes": "Rule: term, quantity, and product must be present; start date must be at least 14 days out, or flag."
    },
    {
      "id": "route_by_discount_tier",
      "name": "Route to approver by discount tier",
      "actor": "Deal desk analyst",
      "system": "CRM",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "low",
      "depends_on": ["validate_deal_fields"],
      "notes": "Rule: up to 15% auto-approved, 15-25% sales manager, above 25% finance."
    },
    {
      "id": "approve_nonstandard_discount",
      "name": "Approve non-standard discount",
      "actor": "Sales manager / finance",
      "system": "CRM",
      "input_type": "structured",
      "rule_clarity": "none",
      "reversibility": "costly",
      "consequence": "high",
      "domains": ["financial"],
      "volume": "medium",
      "exception_rate": "high",
      "depends_on": ["route_by_discount_tier"],
      "notes": "Depends on deal strategy, customer relationship, and competitive pressure. Genuine judgment."
    },
    {
      "id": "summarize_nonstandard_terms",
      "name": "Summarize requested contract changes",
      "actor": "Deal desk analyst",
      "system": "Email / contract redlines",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "reversible",
      "consequence": "medium",
      "domains": ["legal"],
      "volume": "low",
      "exception_rate": "high",
      "depends_on": ["capture_deal_request"],
      "notes": "AI summarizes redlines against standard terms and flags risky clauses; legal makes the call."
    },
    {
      "id": "generate_quote",
      "name": "Generate quote from approved terms",
      "actor": "Deal desk analyst",
      "system": "CPQ",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["financial"],
      "volume": "high",
      "exception_rate": "low",
      "depends_on": ["approve_nonstandard_discount", "summarize_nonstandard_terms"]
    },
    {
      "id": "send_contract",
      "name": "Send contract for e-signature",
      "actor": "CPQ workflow",
      "system": "E-signature",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["legal"],
      "volume": "high",
      "exception_rate": "low",
      "already_automated": true,
      "depends_on": ["generate_quote"]
    },
    {
      "id": "draft_customer_update",
      "name": "Update customer on deal status",
      "actor": "Sales rep",
      "system": "Email",
      "input_type": "unstructured",
      "rule_clarity": "partial",
      "reversibility": "costly",
      "consequence": "medium",
      "domains": ["relationship"],
      "volume": "medium",
      "exception_rate": "medium",
      "depends_on": ["approve_nonstandard_discount"],
      "notes": "Explaining a partial approval or a counter-offer. Tone matters."
    },
    {
      "id": "release_order_to_billing",
      "name": "Release order to billing",
      "actor": "Deal desk analyst",
      "system": "Billing",
      "input_type": "structured",
      "rule_clarity": "clear",
      "reversibility": "irreversible",
      "consequence": "high",
      "domains": ["financial", "compliance"],
      "volume": "high",
      "exception_rate": "low",
      "depends_on": ["send_contract"],
      "notes": "Rule: contract signed AND signed pricing matches the approved quote. Revenue recognition depends on it."
    }
  ]
}
